{
  "name": "pinsay-extension",
  "version": "0.9.0",
  "private": true,
  "description": "PinSay feedback — Chrome/Chromium browser extension (MV3)",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/pinsay-dev/pinsay-extension.git" },
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "package": "node scripts/package.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"test/*.test.ts\"",
    "cws:auth": "node scripts/cws-auth.mjs",
    "cws:publish": "node scripts/cws-publish.mjs",
    "publish": "node scripts/publish.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "typescript": "^5.7.3",
    "@types/chrome": "^0.0.287"
  },
  "allowScripts": {
    "esbuild@0.24.2": true
  }
}
